# VoxSpeak Production Environment Variables
# Copy this to .env and fill in your values

# --- Database ---
POSTGRES_PASSWORD=change_this_to_a_secure_password

# --- Object Storage ---
MINIO_ROOT_USER=voxspeak
MINIO_ROOT_PASSWORD=change_this_minio_secret

# --- API ---
DATABASE_URL=postgresql://voxspeak:${POSTGRES_PASSWORD}@postgres:5432/voxspeak
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
AI_SERVICE_URL=http://ai-service:8000
JWT_SECRET=change_this_jwt_secret
CORS_ORIGIN=https://voxspeak.app

# --- AI Service ---
OLLAMA_URL=http://ollama:11434
MODEL_SIZE=base

# --- Web ---
NEXT_PUBLIC_API_URL=https://api.voxspeak.app
NEXT_PUBLIC_WS_URL=wss://api.voxspeak.app
